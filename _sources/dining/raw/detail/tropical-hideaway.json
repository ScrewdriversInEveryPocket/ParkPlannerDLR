{"meta":{"description":"Escape to the Tropical Hideaway, a jungle oasis offering fast ‘n’ easy fare with a sense of adventure! Nestled in Adventureland, enjoy sweet and savory meal options, a place to relax along the Jungle Cruise waterfront and jokes by Rosita, one of the singing birds from Walt Disney’s Enchanted Tiki Room.","keywords":"tropical hideaway, dining, adventure land, rosita, jungle cruise","title":"Tropical Hideaway  | Disneyland Resort"},"id":"19197204;entityType=restaurant","theme":"hyperion","entityTypeUrl":"/dining/#/","type":"restaurant","contentService":"explorer","themeData":{"finder":"hyperion"},"aagData":{"type":"restaurant","title":"The Tropical Hideaway","location":"Disneyland Park","admissionRequired":{"title":"Valid Ticket and Park Reservation for Same Park on Same Date Required"},"description":"Escape to an amazing jungle oasis offering fast ‘n’ easy fare with a sense of adventure in the air!","media":{"desktop":"https://cdn1.parksmedia.wdprapps.disney.com/resize/mwImage/1/1600/900/75/dam/disneyland/dining/disneyland/tropical-hideaway/tropical-hideaway-architect-atmosphere-16x9.jpg?1777472776247","mobile":"https://cdn1.parksmedia.wdprapps.disney.com/resize/mwImage/1/630/354/75/dam/disneyland/dining/disneyland/tropical-hideaway/tropical-hideaway-architect-atmosphere-16x9.jpg?1777472776247","media":"(max-width: 768px)","alt":"The exterior of The Tropical Hideaway lit at night"},"breadcrumb":{"template":"Located in {link} at {link}","data":[{"label":"Adventureland","link":"/destinations/disneyland/adventureland/","title":"Go to  Adventureland"},{"label":"Disneyland Park","link":"/destinations/disneyland/","title":"Go to  Disneyland Park"}]},"facetGroups":[{"name":"cuisine","icon":"dining","facets":[{"name":"Vegetarian","urlFriendlyId":"vegetarian-cuisine","url":"/dining/#/vegetarian-cuisine","isClickable":false},{"name":"Quick Service","urlFriendlyId":"quick-service","url":"/dining/#/quick-service","isClickable":false}]}],"discountsModal":{"